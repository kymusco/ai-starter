# Copie para .env na raiz (vale para os dois apps em desenvolvimento).

# Chave do provedor de modelo. Com a OpenAI, uma chave só serve ao chat e aos embeddings.
OPENAI_API_KEY=

# Modelos, no formato provedor/modelo. Trocar de provedor = trocar aqui e pôr a chave dele
# (ANTHROPIC_API_KEY, GOOGLE_GENERATIVE_AI_API_KEY, OPENROUTER_API_KEY...).
MODEL=openai/gpt-5-mini
EMBEDDING_MODEL=openai/text-embedding-3-small

# Banco local (npm run db sobe um PostgreSQL com pgvector no Docker).
DATABASE_URL=postgresql://app:app@localhost:5432/app

# Onde o web encontra o agente.
AGENT_URL=http://localhost:4111

# Senha da tela /admin, que aprova os chamados urgentes (12 caracteres ou mais).
# Sem ela, a tela fica fechada.
ADMIN_PASSWORD=

# Limite de uso do chat (protege a sua chave de modelo). Padrões: 30, 100 e 2000.
# CHAT_LIMIT_VISITOR_HOUR=30   mensagens por visitante por hora
# CHAT_LIMIT_IP_HOUR=100       mensagens por endereço IP por hora
# CHAT_LIMIT_TOTAL_DAY=2000    teto do dia para o app inteiro

# Observabilidade: traces, métricas e avaliações no PostgreSQL.
# OBSERVABILITY_RETENTION_DAYS=14  dias de histórico (traces contêm conversas)
# OBSERVABILITY_DATABASE_URL=      banco separado para observabilidade (recomendado com volume)
# EVAL_SAMPLE_RATE=0.1             fração das respostas avaliadas (cada avaliação gasta modelo; 0 desliga)
# EVAL_MODEL=                      modelo do avaliador (padrão: MODEL)
